# ─────────────────────────────────────────────────────────────────────────────
# Production environment for docker-compose.prod.yml
#
# Copy to `.env` on the VPS (next to docker-compose.prod.yml), fill in the
# values, then run:  docker compose -f docker-compose.prod.yml up -d --build
#
# `.env` is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain / URLs ────────────────────────────────────────────────────────────
# APP_DOMAIN is the hostname Caddy serves and requests a certificate for.
APP_DOMAIN="fresh-basket.abhijitborgohain.online"
NEXTAUTH_URL="https://fresh-basket.abhijitborgohain.online"
NEXT_PUBLIC_APP_URL="https://fresh-basket.abhijitborgohain.online"
NEXT_PUBLIC_API_URL="https://fresh-basket.abhijitborgohain.online"

# ── Database ─────────────────────────────────────────────────────────────────
# Only used to initialise the Postgres container on first run; the app
# connects to the `db` service inside Docker.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="grocery"

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value for both variables unless you know you need different ones.
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Authorised redirect URI:
#   https://fresh-basket.abhijitborgohain.online/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── First-run seed (used only by the manual seed command, not by compose) ───
# Setting these avoids creating an admin account with the public demo password.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
# false => do not create staff/delivery/demo-customer accounts.
SEED_DEMO_USERS="false"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required for OTP login and order emails in production. With OTP_PROVIDER=mock
# the code is only written to the container log and users cannot see it.
RESEND_API_KEY=""
MAIL_FROM="Fresh Basket <orders@abhijitborgohain.online>"
OTP_PROVIDER="resend"

# ── Notifications outbox processor ───────────────────────────────────────────
# Protects /api/cron/notifications; call that endpoint from a cron job.
CRON_SECRET=""

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Images (Cloudinary) ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
