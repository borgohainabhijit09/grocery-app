# ─────────────────────────────────────────────────────────────────────────────
# Grocery App — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env with credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local Docker default. For managed PG (Supabase/Neon) set DATABASE_URL to the
# pooled connection and DIRECT_URL to the direct (non-pooled) connection.
DATABASE_URL="postgresql://postgres:password@localhost:5460/grocery"
DIRECT_URL="postgresql://postgres:password@localhost:5460/grocery"

# ── Auth (NextAuth / Auth.js) ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
AUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3010"
AUTH_TRUST_HOST="true"

# Public base URL of the web app (used for absolute links / mobile API base)
NEXT_PUBLIC_APP_URL="http://localhost:3010"
NEXT_PUBLIC_API_URL="http://localhost:3010"

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# When RESEND_API_KEY / MAIL_FROM are unset the app logs notifications instead
# of sending them (dev no-op) and still marks them as sent.
RESEND_API_KEY=""
MAIL_FROM="orders@example.com"

# ── Notifications outbox processor ───────────────────────────────────────────
# Protects /api/cron/notifications. Required in production.
CRON_SECRET=""

# ── Images (Cloudinary) ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Phone OTP ────────────────────────────────────────────────────────────────
# "mock" logs the code to the server console and (outside production) returns it
# so the UI can show a dev hint. "resend" emails the code via the Resend settings
# above. No paid SMS subscription is required to develop or test.
OTP_PROVIDER="mock"
