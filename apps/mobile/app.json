{
  "expo": {
    "name": "Fresh Basket",
    "slug": "fresh-basket",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "freshbasket",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freshbasket.app"
    },
    "android": {
      "package": "com.freshbasket.app",
      "adaptiveIcon": {
        "backgroundColor": "#16a34a"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Fresh Basket to use your location to set your delivery address."
        }
      ]
    ]
  }
}
